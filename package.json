{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "description": "Electron desktop shell for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "dist/main/main/index.js",
  "packageManager": "pnpm@10.15.0",
  "volta": {
    "node": "22.20.0",
    "pnpm": "10.15.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -n vite,electron -c blue,yellow 'vite --config vite.config.ts' 'wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron dist/main/main/index.js'",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build --config vite.config.ts",
    "build:electron": "tsc -b tsconfig.node.json --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tooling.json --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.mjs\" \"*.{json,yml,mjs,ts}\"",
    "test": "node --test tests/**/*.test.mjs && vitest run --config vitest.config.ts",
    "package": "pnpm build && electron-builder",
    "package:all": "pnpm build && electron-builder --mac dmg --win nsis --linux AppImage deb",
    "prepare:harness": "node scripts/prepare-harness-runtime.mjs",
    "verify:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "39.0.0",
    "electron-builder": "26.0.12",
    "electron-builder-squirrel-windows": "26.0.12",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wait-on": "^9.1.0"
  }
}
